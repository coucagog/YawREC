# ============================================================
# YAWREC · .gitignore
# ============================================================

# --- Rust / Cargo ---
src-tauri/target/
# Cargo.lock est versionné : c'est une application, les builds doivent être
# reproductibles (sans lui, la résolution des features du crate `windows`
# dépendait des versions tirées au moment du build).
src-tauri/gen/
# DLL FFmpeg copiées par build.rs au moment du build
src-tauri/resources/ffmpeg-dlls/

# --- Node / Vite ---
node_modules/
dist/
.npm/
.eslintcache

# --- Tauri ---
src-tauri/WixTools/
src-tauri/.tauri/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Outputs en dev ---
*.mp4
*.webm
*.mkv
